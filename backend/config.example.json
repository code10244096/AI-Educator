{
  "app": {
    "name": "AI 教学助手",
    "version": "1.0.0",
    "debug": true
  },
  "api": {
    "prefix": "/api",
    "cors_origins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "database": {
    "url": "sqlite+aiosqlite:///./teaching_assistant.db"
  },
  "ai": {
    "api_key": "your_api_key_here",
    "base_url": "https://api.openai.com/v1",
    "ocr_model": "gpt-4-vision-preview",
    "grader_model": "gpt-4",
    "lessonplan_model": "gpt-4"
  },
  "upload": {
    "dir": "./uploads",
    "max_file_size": 10485760,
    "allowed_extensions": [
      "jpg",
      "jpeg",
      "png",
      "gif"
    ]
  },
  "jwt": {
    "secret_key": "your-secret-key-change-in-production",
    "algorithm": "HS256",
    "access_token_expire_minutes": 30
  },
  "llm": {
    "provider": "yibu",
    "api_key": "your_api_key_here",
    "base_url": "https://yibuapi.com/v1",
    "models": {
      "default": "gemini-3.1-pro-preview",
      "ocr": "gpt-5.5",
      "grade": "gemini-3.1-pro-preview",
      "variant": "gemini-3.1-pro-preview",
      "lessonplan": "gemini-3.1-pro-preview"
    },
    "timeout": 600,
    "max_retries": 1,
    "use_proxy": false,
    "proxy_url": "",
    "verify_ssl": true,
    "log_root": "api_runs",
    "log_request_content": true,
    "fallbacks": {
      "ocr": [
        "deepseek-v4.1-flash"
      ],
      "grade": [
        "deepseek-v4.1-flash"
      ],
      "variant": [
        "deepseek-v4.1-flash"
      ],
      "lessonplan": [
        "deepseek-v4.1-flash"
      ]
    },
    "_comment_models": "2026-11-02 固定模型（仅3个）：gemini-3.1-pro-preview（教案/批改主模型）、deepseek-v4.1-flash（变式主模型+全功能备用）、gpt-5.5（OCR识别）。"
  }
}