# 后端环境变量说明（本地开发用；生产部署请看仓库根目录 .env.example 与 DEPLOY_2GB.md）
# 后端只读取“环境变量”，不会自动加载本文件；本地可以在终端里 export / set 后再启动 uvicorn。

# 运行环境：development（默认）/ production
APP_ENV=development

# 会话签名密钥（生产必填，至少 32 位随机字符串）
JWT_SECRET=
SESSION_EXPIRE_MINUTES=10080

# 大模型网关；your_api_key_here 表示模拟模式（只允许开发环境）
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://yibuapi.com/v1

# 跨域白名单（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 数据库 / 上传目录 / 模型调用日志目录（相对路径按 backend/ 解析）
DATABASE_URL=sqlite+aiosqlite:///./teaching_assistant.db
UPLOAD_DIR=./uploads
API_OUTPUT_ROOT=../api_runs

# 批改队列
GRADING_CONCURRENCY=4
DAILY_GRADING_QUOTA=300
# 模拟模式下每次模拟调用等待的秒数（测试排队用）
MOCK_LLM_DELAY_SECONDS=0

# 演示数据（仅开发环境；生产强制关闭）
SEED_DEMO_DATA=false

# 打印 SQL（调试用，生产强制关闭）
SQL_ECHO=false
