# ============================================================
# AI 教学助手 生产环境配置（docker compose 通过 env_file 读取）
# 用法：cp .env.example .env，按注释填写；.env 含密钥，不要提交到 git
# ============================================================

# 运行环境（compose 中已强制为 production；production 下禁止模拟模式、关闭接口文档）
APP_ENV=production

# 会话签名密钥：必填，至少 32 位随机字符串。生成：openssl rand -hex 32
JWT_SECRET=

# 会话有效期（分钟），默认 7 天
SESSION_EXPIRE_MINUTES=10080

# 大模型网关（OpenAI 兼容接口）：必填，生产没有有效 Key 会拒绝启动
LLM_API_KEY=
LLM_BASE_URL=https://yibuapi.com/v1
# 分功能模型（留空用内置默认：ocr=gpt-5.5，grade/variant/lessonplan=gemini-3.1-pro-preview）
# LLM_MODEL=gemini-3.1-pro-preview
# LLM_MODEL_OCR=gpt-5.5
# LLM_MODEL_GRADE=gemini-3.1-pro-preview
# LLM_MODEL_VARIANT=gemini-3.1-pro-preview
# LLM_MODEL_LESSONPLAN=gemini-3.1-pro-preview
# 模型调用日志是否记录请求/回复原文（含学生作业内容），默认记录；隐私要求高时设为 false
# LLM_LOG_REQUEST_CONTENT=true

# 跨域白名单（逗号分隔，填部署域名）；前后端经 nginx 同域访问时可留空（不放行任何跨域请求）
CORS_ORIGINS=https://your-school-domain.example

# 数据库（容器内路径，对应宿主机 ./data 目录；一般不用改）
DATABASE_URL=sqlite+aiosqlite:////app/data/teaching_assistant.db
# 老师生成的教案、批改、变式题按登录账号留在同一数据目录：宿主机 ./data/user_records/
# USER_RECORDS_DIR=/app/data/user_records

# 批改队列：全局同时批改的份数（2 核 2GB 建议 4）、每位老师每天最多提交的批改份数
GRADING_CONCURRENCY=4
DAILY_GRADING_QUOTA=300

# 演示数据：生产必须为 false（production 下强制关闭）
SEED_DEMO_DATA=false

# 公测：true 时可用手机号领取注册码登录。不会自动建匿名账号。管理员仍用自己的账号密码。
PUBLIC_BETA=true

# 公测体验额度。第一档用完且当天提交过意见后，才升到第二档。返回给用户的句子里不要写这些数字。
# TRIAL_QUOTA_ENABLED=true
# TRIAL_BASE_TOKENS=10000
# TRIAL_BASE_GRADE=5
# TRIAL_BASE_LESSONPLAN=2
# TRIAL_BASE_VARIANT=2
# TRIAL_EXT_TOKENS=30000
# TRIAL_EXT_GRADE=10
# TRIAL_EXT_LESSONPLAN=5
# TRIAL_EXT_VARIANT=5
# TRIAL_CALLS_PER_MINUTE=5

# 会话 Cookie 仅走 HTTPS（production 默认开启；仅在内网纯 HTTP 临时测试时才设为 false）
# COOKIE_SECURE=true
